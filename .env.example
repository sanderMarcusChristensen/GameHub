CITO_API_KEY=cito_INSERT_YOUR_KEY_HERE
RIOT_API_KEY=RGAPI_INSERT_YOUR_KEY_HERE

# MySQL root — read by docker-compose.yml. Use an alphanumeric password.
MYSQL_ROOT_PASSWORD=CHANGE_ROOT_PASSWORD

# Four accounts are created by data/database/init/06_users_and_privileges.sql.
# 123456 is the actual local demo password, not a placeholder — leave it as is
# and keep the two files in sync. Only MYSQL_APP_* is used by the backend.
MYSQL_APP_USERNAME=gamehub_app
MYSQL_APP_PASSWORD=123456
MYSQL_ADMIN_USERNAME=gamehub_admin
MYSQL_ADMIN_PASSWORD=123456
MYSQL_READONLY_USERNAME=gamehub_readonly
MYSQL_READONLY_PASSWORD=123456
MYSQL_RESTRICTED_USERNAME=gamehub_restricted
MYSQL_RESTRICTED_PASSWORD=123456

# Spring Boot datasource — connection details only; credentials come from MYSQL_APP_*.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=gameHub

SESSION_COOKIE_SECURE=false

# MongoDB
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGODB_URI=mongodb://admin:DIN_ADGANGSKODE@localhost:27017/gamehub_documents?authSource=admin

# AI integration
# Set AI_ENABLED to true to enable AI features, and provide the base URL and model name for Ollama.
AI_ENABLED=false
OLLAMA_BASE_URL=Your_Ollama_Base_URL
OLLAMA_MODEL=Name_of_the_model_you_want_to_use


